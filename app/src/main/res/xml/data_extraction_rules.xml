<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the database -->
        <include domain="database" />
        
        <!-- Include shared preferences -->
        <include domain="sharedpref" />
        
        <!-- Exclude cache -->
        <exclude domain="cache" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Include all app data for device transfer -->
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>