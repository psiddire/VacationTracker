<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <!-- Map Fragment -->
    <fragment
        android:id="@+id/map_fragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Control Panel -->
    <LinearLayout
        android:id="@+id/top_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_anchor="@id/map_fragment"
        app:layout_anchorGravity="top">

        <TextView
            android:id="@+id/tv_current_trip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No active trip"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/sunset_orange" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_history"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_history"
                android:padding="8dp"
                app:tint="@color/forest_green"
                android:contentDescription="Trip History" />

            <ImageView
                android:id="@+id/icon_trip_action"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_play"
                android:padding="8dp"
                app:tint="@color/primary"
                android:contentDescription="Start Trip" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Control Panel -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Trip Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:id="@+id/layout_trip_stats">

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Distance: 0 km"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Duration: 0h 0m"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_places"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Places: 0"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Geo-fencing Icon -->
            <ImageView
                android:id="@+id/icon_geofence"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:enabled="false"
                android:src="@drawable/ic_location"
                android:padding="8dp"
                app:tint="@color/sunset_orange"
                android:contentDescription="Add place" />

            <!-- Camera Icon -->
            <ImageView
                android:id="@+id/icon_camera"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:enabled="false"
                android:src="@drawable/ic_camera"
                android:padding="8dp"
                app:tint="@color/primary"
                android:contentDescription="Take photo for current place" />

        </LinearLayout>

    </LinearLayout>

    <!-- Map Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="160dp"
        android:orientation="vertical">

        <!-- Zoom In -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/surface"
            android:contentDescription="Zoom In"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_zoom_in"
            app:tint="@color/primary" />

        <!-- Zoom Out -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/surface"
            android:contentDescription="Zoom Out"
            app:borderWidth="0dp"
            app:elevation="6dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_zoom_out"
            app:tint="@color/primary" />

        <!-- My Location -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            style="@style/FunFAB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="My Location"
            app:srcCompat="@drawable/ic_my_location" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>