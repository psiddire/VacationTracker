<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- Storage permissions for photos -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Photo monitoring permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    
    <!-- Network permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- Wake lock for background tracking -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VacationTracker"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VacationTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Itinerary Activity -->
        <activity
            android:name=".activities.ItineraryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Trip History Activity -->
        <activity
            android:name=".activities.TripHistoryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Trip Detail Activity -->
        <activity
            android:name=".activities.TripDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.TripHistoryActivity"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Place Detail Activity -->
        <activity
            android:name=".activities.PlaceDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.ItineraryActivity"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Photo Viewer Activity -->
        <activity
            android:name=".activities.PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.VacationTracker.FullScreen" />

        <!-- Photo Suggestion Activity -->
        <activity
            android:name=".activities.PhotoSuggestionActivity"
            android:exported="false"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Trip Map Activity -->
        <activity
            android:name=".activities.TripMapActivity"
            android:exported="false"
            android:parentActivityName=".activities.TripDetailActivity"
            android:theme="@style/Theme.VacationTracker.NoActionBar" />

        <!-- Location Tracking Service -->
        <service
            android:name=".services.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Photo Monitoring Service -->
        <service
            android:name=".services.PhotoMonitoringService"
            android:enabled="true"
            android:exported="false" />

        <!-- WorkManager initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

        <!-- FileProvider for photo sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.vacationtracker.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>